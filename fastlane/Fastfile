default_platform(:ios)

BUNDLE_ID = "com.judahjudah.RubberBandBall"
SCHEME = "RubberBandBall"

platform :ios do
  def asc_key
    app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_CONTENT"],
      in_house: false
    )
  end

  desc "Create or fetch signing certificates (run once)"
  lane :certs do
    match(type: "appstore", app_identifier: BUNDLE_ID, api_key: asc_key)
  end

  desc "Build and upload a new TestFlight build"
  lane :beta do
    setup_ci if ENV["CI"]
    key = asc_key
    match(type: "appstore", app_identifier: BUNDLE_ID, readonly: true, api_key: key)
    latest = latest_testflight_build_number(app_identifier: BUNDLE_ID, api_key: key)
    increment_build_number(build_number: latest + 1, xcodeproj: "RubberBandBall.xcodeproj")
    build_app(
      scheme: SCHEME,
      export_method: "app-store",
      xcargs: "DEVELOPMENT_TEAM=QW4XX3FK3Y CODE_SIGN_STYLE=Manual CODE_SIGN_IDENTITY='Apple Distribution' PROVISIONING_PROFILE_SPECIFIER='match AppStore #{BUNDLE_ID}'",
      export_options: {
        method: "app-store",
        signingStyle: "manual",
        teamID: "QW4XX3FK3Y",
        provisioningProfiles: { BUNDLE_ID => "match AppStore #{BUNDLE_ID}" }
      }
    )
    upload_to_testflight(api_key: key, skip_waiting_for_build_processing: true)
  end
end
